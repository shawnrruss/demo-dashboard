---
// Directory page: each fixture member links to the static profile built by members/[id].astro.
import Layout from '../layouts/Layout.astro';
import { listMembers } from '../lib/data';
const members = await listMembers();
---
<Layout title="Members">
  <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-green-800">Our little community</p>
  <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">Good things grow here.</h1>
  <p class="mt-5 max-w-xl text-lg text-green-950/70">Meet the people tending our shared patch. Visit a member to see their plot bookings and volunteer contributions.</p>
  <div class="mt-10 flex items-center justify-between border-b border-green-900/20 pb-4">
    <h2 class="text-2xl font-semibold">Members</h2><span class="text-sm">{members.length} gardeners</span>
  </div>
  <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {members.map(member => <li class="rounded-2xl border border-green-900/15 bg-white p-6">
      <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-lime-100 text-xl font-semibold" aria-hidden="true">{member.name.split(' ').map(part => part[0]).join('')}</div>
      <h3 class="text-xl font-semibold"><a class="underline decoration-green-800/30 underline-offset-4" href={`/members/${member.id}/`}>{member.name}</a></h3>
      <p class="mt-2 text-green-950/70">Plot {member.plot}</p>
      <p class="mt-5 text-sm text-green-950/60">Growing with us since {member.joined.slice(0, 4)}</p>
    </li>)}
  </ul>
</Layout>
